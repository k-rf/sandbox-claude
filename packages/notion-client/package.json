{
  "name": "@monorepo/notion-client",
  "version": "0.1.0",
  "description": "Notion API client with Effect-TS and Hexagonal Architecture",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext ts",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "effect": "^3.10.0",
    "@effect/platform": "^0.70.0",
    "@effect/schema": "^0.75.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3",
    "vitest": "^4.1.8"
  }
}
